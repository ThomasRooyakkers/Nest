# Copy to deploy/.env on the Pi and fill in. Never commit .env.
# Generate random values with: openssl rand -base64 48 | tr -d '\n/+='

# This server's addresses: the web app and the API (both behind https).
NEST_WEB_DOMAIN=nest.example.com
NEST_API_DOMAIN=nest-api.example.com
# The account with this email becomes super-admin and may always sign up.
SUPER_ADMIN_EMAIL=you@example.com
# invite-only (default: a household invite code is needed) or open.
SIGN_UP_MODE=invite-only

DATABASE_PASSWORD=CHANGE_ME
SERVICE_SECRET=CHANGE_ME
EMAIL_SECRET_HASH_PEPPER=CHANGE_ME
JWT_HMAC_SHA512_PRIVATE_KEY=CHANGE_ME
JWT_REFRESH_TOKEN_HASH_PEPPER=CHANGE_ME

# Token of the Cloudflare Tunnel "Nest" (Zero Trust > Networks > Tunnels).
TUNNEL_TOKEN=CHANGE_ME

# Resend (optional until set up): API key and a sender on a verified domain.
RESEND_API_KEY=
MAIL_FROM=Nest <nest@example.com>

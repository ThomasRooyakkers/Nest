# Settings of your Nest server. Save as .env next to docker-compose.yml and
# fill in. Never share or commit .env.
# Make random secrets with: openssl rand -base64 48 | tr -d '\n/+='

# --- Your server -----------------------------------------------------------

# The web address and the API address. Both must reach this server over
# https (Cloudflare Tunnel or your own proxy). App users type the web
# address; it serves a short page pointing to the app (no web version).
NEST_WEB_DOMAIN=nest.example.com
NEST_API_DOMAIN=nest-api.example.com

# Optional: the address of the admin portal, e.g. nest-admin.example.com.
# Route it like the web address (port 8082) and protect it, e.g. with
# Cloudflare Access. Without it the admin portal is not served.
NEST_ADMIN_DOMAIN=

# The account with this email becomes super-admin, and may sign up without
# an invite code.
SUPER_ADMIN_EMAIL=you@example.com

# Who may create an account: invite-only (a household invite code is needed)
# or open (anyone who can reach the server).
SIGN_UP_MODE=invite-only

# The server and backup images and the version to run.
NEST_IMAGE=ghcr.io/thomasrooyakkers/nest-server
NEST_BACKUP_IMAGE=ghcr.io/thomasrooyakkers/nest-backup
NEST_VERSION=latest

# --- Secrets (each one a different random value) ---------------------------

DATABASE_PASSWORD=CHANGE_ME
SERVICE_SECRET=CHANGE_ME
EMAIL_SECRET_HASH_PEPPER=CHANGE_ME
JWT_HMAC_SHA512_PRIVATE_KEY=CHANGE_ME
JWT_REFRESH_TOKEN_HASH_PEPPER=CHANGE_ME
# Encrypts the backups. Keep a copy somewhere else (a password manager):
# without it no backup can be restored.
RESTIC_PASSWORD=CHANGE_ME

# --- Backups ------------------------------------------------------------------

# Where backups go: space-separated name=repository pairs. The default keeps
# them in ./backups/restic on this machine; add a second place so a broken
# disk does not take the backups with it:
#   a folder, e.g. an NFS share mounted here: set BACKUP_EXTRA_DIR to it and
#     add nas=/backups-extra/restic
#   OneDrive or another rclone remote: put rclone.conf in ./rclone and add
#     onedrive=rclone:onedrive:nest
BACKUP_TARGETS=local=/backups/restic
# BACKUP_EXTRA_DIR=/mnt/nas/nest
# Local time of the daily backup, in the time zone TZ.
BACKUP_TIME=03:00
TZ=Europe/Brussels

# --- Mail (optional) --------------------------------------------------------

# Sign-up and password reset codes are emailed through Resend
# (https://resend.com) when both are set; otherwise they appear in
# `docker compose logs nest`. The sender's domain must be verified in Resend.
RESEND_API_KEY=
MAIL_FROM=Nest <nest@example.com>

# --- Film data (optional) ---------------------------------------------------

# The watchlist searches films and series through TMDB with your own key
# (https://www.themoviedb.org/settings/api: the API key or the API read
# access token). Without it the server offers a few sample titles.
TMDB_API_KEY=

# --- Google and Apple sign-in (optional) ------------------------------------

# Only for the Nest iOS app as published by its maintainer: the app carries
# Google and Apple client settings that belong to the maintainer's accounts,
# so these work only with keys issued for that app (bundle ID be.g3cko.nest).
# Leave them empty and the app offers email sign-in only.
#
# Google: the JSON file of the OAuth client of type "Web application", on
# one line in single quotes.
GOOGLE_CLIENT_SECRET_JSON=
# Apple: the Services ID, Team ID, the Key ID and the contents of the .p8
# key (on one line in double quotes, with \n for each line break).
APPLE_SERVICE_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_KEY=
# Only when you build your own iOS app: its bundle ID.
APPLE_BUNDLE_ID=

# --- Network ----------------------------------------------------------------

# Cloudflare Tunnel: uncomment both and paste the tunnel token. Route the web
# domain to http://nest:8082 and the API domain to http://nest:8080.
# COMPOSE_PROFILES=tunnel
# TUNNEL_TOKEN=

# Own https proxy: it forwards the web domain to port 8082 and the API domain
# to port 8080 on this machine (WebSockets included).
# NEST_BIND_ADDRESS=127.0.0.1
# NEST_API_PORT=8080
# NEST_WEB_PORT=8082

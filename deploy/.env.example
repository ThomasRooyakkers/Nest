# Settings of your Nest server. Save as .env next to docker-compose.yml and
# fill in. Never share or commit .env.
# Make random secrets with: openssl rand -base64 48 | tr -d '\n/+='

# --- Your server -----------------------------------------------------------

# The addresses of the web app and of the API. Both must reach this server
# over https (Cloudflare Tunnel or your own proxy), and the app users type
# the web app address.
NEST_WEB_DOMAIN=nest.example.com
NEST_API_DOMAIN=nest-api.example.com

# The account with this email becomes super-admin, and may sign up without
# an invite code.
SUPER_ADMIN_EMAIL=you@example.com

# Who may create an account: invite-only (a household invite code is needed)
# or open (anyone who can reach the server).
SIGN_UP_MODE=invite-only

# The server image and version to run.
NEST_IMAGE=ghcr.io/thomasrooyakkers/nest-server
NEST_VERSION=latest

# --- Secrets (each one a different random value) ---------------------------

DATABASE_PASSWORD=CHANGE_ME
SERVICE_SECRET=CHANGE_ME
EMAIL_SECRET_HASH_PEPPER=CHANGE_ME
JWT_HMAC_SHA512_PRIVATE_KEY=CHANGE_ME
JWT_REFRESH_TOKEN_HASH_PEPPER=CHANGE_ME

# --- Mail (optional) --------------------------------------------------------

# Sign-up and password reset codes are emailed through Resend
# (https://resend.com) when both are set; otherwise they appear in
# `docker compose logs nest`. The sender's domain must be verified in Resend.
RESEND_API_KEY=
MAIL_FROM=Nest <nest@example.com>

# --- Film data (optional) ---------------------------------------------------

# The watchlist searches films and series through TMDB with your own key
# (https://www.themoviedb.org/settings/api: the API key or the API read
# access token). Without it the server offers a few sample titles.
TMDB_API_KEY=

# --- Network ----------------------------------------------------------------

# Cloudflare Tunnel: uncomment both and paste the tunnel token. Route the web
# domain to http://nest:8082 and the API domain to http://nest:8080.
# COMPOSE_PROFILES=tunnel
# TUNNEL_TOKEN=

# Own https proxy: it forwards the web domain to port 8082 and the API domain
# to port 8080 on this machine (WebSockets included).
# NEST_BIND_ADDRESS=127.0.0.1
# NEST_API_PORT=8080
# NEST_WEB_PORT=8082
